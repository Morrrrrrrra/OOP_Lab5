using System;
    public interface ISaveable    // Інтерфейс з методом Save()
    {
        void Save();
    }
    public class File : ISaveable    // Клас File, що реалізує інтерфейс ISaveable
    {
        public string FileName { get; set; }

        public File(string fileName)
        {
            FileName = fileName;
        }
        void ISaveable.Save()        // Реалізація методу Save()
        {
            Console.WriteLine($"File '{FileName}' has been successfully saved.");
        }
    }
    class Program
    {
        static void Main(string[] args)
        {
            File myFile = new File("NewFile.txt");    // Створення об’єкта класу File
            ISaveable saveableFile = myFile;          // Виклик методу Save() через інтерфейсне посилання
            saveableFile.Save();
        }
    }
