using System;
    public interface ILoginable    // Оголошення інтерфейсу з методом Login()
    {
        void Login();
    }
    public class User : ILoginable    // Клас User, що реалізує інтерфейс ILoginable
    {
        public string Username { get; set; }

        public User(string username)
        {
            Username = username;
        }
        public void Login()   // Реалізація методу Login()
        {
            Console.WriteLine($"{Username} has successfully logged in.");
        }
    }
    class Program
    {
        static void Main(string[] args)
        {
            User user = new User("Andrew");       // Створення об’єкта класу User
            ILoginable loginableUser = user; // Виклик методу Login за допомогою інтерфейсу           
            loginableUser.Login();
            user.Login();         // Безпосередній виклик методу Login
        }
    }
