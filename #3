using System;
public class Box<T> : ICloneable    // Узагальнений клас Box<T>, який реалізує ICloneable
{
    public T Item { get; set; }
    public Box(T item)
    {
        Item = item;
    }
    public object Clone()      // Реалізація методу Clone()
    {
        return new Box<T>(this.Item);
    }
}
class Program
{
    static void Main(string[] args)
    {
        Box<string> originalBox = new Box<string>("Book");         // Створення об’єкта Box
        Box<string> clonedBox = (Box<string>)originalBox.Clone();  // Копіювання через метод Clone()
        Console.WriteLine($"Original: {originalBox.Item}");
        Console.WriteLine($"Clone: {clonedBox.Item}");
    }
}
